# Generate a random value for production, for example:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-local-development-secret

# Set this to an existing email address so that account receives the admin role on database init
ADMIN_EMAIL=

# SMTP settings
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
SMTP_STARTTLS=false
SMTP_FROM=Review App <noreply@localhost>
